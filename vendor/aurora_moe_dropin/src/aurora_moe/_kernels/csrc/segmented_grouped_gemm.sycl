//
// Runtime-shape grouped GEMM over exact [source, local-expert] route segments.

#include <ATen/ATen.h>
#include <c10/xpu/XPUStream.h>
#include <torch/extension.h>

#include <cute/tensor.hpp>
#include <cute/util/compat.hpp>
#include <cutlass/epilogue/collective/default_epilogue.hpp>
#include <cutlass/epilogue/collective/xe_array_epilogue.hpp>
#include <cutlass/epilogue/fusion/xe_callbacks.hpp>
#include <cutlass/gemm/collective/collective_mma.hpp>
#include <cutlass/gemm/device/gemm_universal_adapter.h>
#include <cutlass/gemm/group_array_problem_shape.hpp>
#include <cutlass/gemm/kernel/xe_gemm_array_cooperative.hpp>
#include <cutlass/kernel_hardware_info.h>
#include <cutlass/util/packed_stride.hpp>
#include <sycl/sycl.hpp>

#include <cstdint>
#include <limits>

#pragma clang diagnostic ignored "-Wpass-failed"
#pragma clang diagnostic ignored "-Wdeprecated-declarations"

namespace aurora_moe {
namespace {

using namespace cute;

using Element = cutlass::bfloat16_t;
using ElementAccumulator = float;
using ElementComputeEpilogue = float;
using ProblemShape = cutlass::gemm::GroupProblemShape<Shape<int, int, int>>;
using LayoutA = cutlass::layout::RowMajor;
using LayoutB = cutlass::layout::RowMajor;
using LayoutC = cutlass::layout::RowMajor;
using LayoutD = cutlass::layout::RowMajor;
using TileShape = Shape<_256, _256, _32>;
using TiledMma = typename TiledMMAHelper<
    MMA_Atom<XE_DPAS_TT<8, ElementAccumulator, Element>>,
    Layout<TileShape>, Layout<Shape<_8, _4, _1>, Stride<_4, _1, _0>>>::TiledMMA;
using MainloopPolicy = cutlass::gemm::MainloopXeL1StagedGroup<2>;
using EpiloguePolicy = cutlass::epilogue::IntelXeGenericGroup;
using EpilogueOp = cutlass::epilogue::fusion::LinearCombination<
    Element, ElementComputeEpilogue, ElementAccumulator, ElementAccumulator,
    cutlass::FloatRoundStyle::round_to_nearest>;
using FusionCallbacks = cutlass::epilogue::fusion::FusionCallbacks<
    EpiloguePolicy, EpilogueOp, TileShape, decltype(tile_shape(TiledMma()))>;
using CollectiveEpilogue = cutlass::epilogue::collective::CollectiveEpilogue<
    EpiloguePolicy, TileShape, void, Element,
    cutlass::gemm::TagToStrideC_t<LayoutC*>, Element,
    cutlass::gemm::TagToStrideC_t<LayoutD*>, FusionCallbacks, void, void>;
using CollectiveMainloop = cutlass::gemm::collective::CollectiveMma<
    MainloopPolicy, TileShape, Element, cutlass::gemm::TagToStrideA_t<LayoutA*>,
    Element, cutlass::gemm::TagToStrideB_t<LayoutB*>, TiledMma, void, void,
    void, cute::identity, void, void, void, cute::identity>;
using GemmKernel = cutlass::gemm::kernel::GemmUniversal<
    ProblemShape, CollectiveMainloop, CollectiveEpilogue,
    cutlass::gemm::GroupScheduler>;
using Gemm = cutlass::gemm::device::GemmUniversalAdapter<GemmKernel>;
using UnderlyingProblemShape = ProblemShape::UnderlyingProblemShape;
using StrideA = GemmKernel::InternalStrideA;
using StrideB = GemmKernel::InternalStrideB;
using StrideC = GemmKernel::InternalStrideC;
using StrideD = GemmKernel::InternalStrideD;
using TileScheduler = cutlass::gemm::kernel::detail::PersistentTileSchedulerXeGroup<
    ProblemShape>;
using RasterOrderOptions = TileScheduler::RasterOrderOptions;

using WeightGradLayoutA = cutlass::layout::ColumnMajor;
using WeightGradLayoutB = cutlass::layout::RowMajor;
using WeightGradLayoutC = cutlass::layout::RowMajor;
using WeightGradLayoutD = cutlass::layout::RowMajor;
using WeightGradCollectiveEpilogue = cutlass::epilogue::collective::CollectiveEpilogue<
    EpiloguePolicy, TileShape, void, Element,
    cutlass::gemm::TagToStrideC_t<WeightGradLayoutC*>, Element,
    cutlass::gemm::TagToStrideC_t<WeightGradLayoutD*>, FusionCallbacks, void, void>;
using WeightGradCollectiveMainloop = cutlass::gemm::collective::CollectiveMma<
    MainloopPolicy, TileShape, Element,
    cutlass::gemm::TagToStrideA_t<WeightGradLayoutA*>, Element,
    cutlass::gemm::TagToStrideB_t<WeightGradLayoutB*>, TiledMma, void, void,
    void, cute::identity, void, void, void, cute::identity>;
using WeightGradGemmKernel = cutlass::gemm::kernel::GemmUniversal<
    ProblemShape, WeightGradCollectiveMainloop, WeightGradCollectiveEpilogue,
    cutlass::gemm::GroupScheduler>;
using WeightGradGemm = cutlass::gemm::device::GemmUniversalAdapter<WeightGradGemmKernel>;
using WeightGradStrideA = WeightGradGemmKernel::InternalStrideA;
using WeightGradStrideB = WeightGradGemmKernel::InternalStrideB;
using WeightGradStrideC = WeightGradGemmKernel::InternalStrideC;
using WeightGradStrideD = WeightGradGemmKernel::InternalStrideD;

class BuildSegmentedMetadataKernel;
class BuildSegmentedWeightGradMetadataKernel;
class ReduceSegmentedWeightGradKernel;

void check_xpu_contiguous(const at::Tensor& tensor, const char* name) {
  TORCH_CHECK(tensor.device().type() == c10::DeviceType::XPU, name,
              " must be an XPU tensor");
  TORCH_CHECK(tensor.is_contiguous(), name, " must be contiguous");
}

void check_bf16_matrix(const at::Tensor& tensor, const char* name, int64_t dim) {
  check_xpu_contiguous(tensor, name);
  TORCH_CHECK(tensor.scalar_type() == at::kBFloat16, name,
              " must have dtype torch.bfloat16");
  TORCH_CHECK(tensor.dim() == dim, name, " has an invalid rank");
}

void check_i32_matrix(const at::Tensor& tensor, const char* name) {
  check_xpu_contiguous(tensor, name);
  TORCH_CHECK(tensor.scalar_type() == at::kInt && tensor.dim() == 2, name,
              " must be an int32 rank-2 tensor");
}

void check_i64_matrix(const at::Tensor& tensor, const char* name) {
  check_xpu_contiguous(tensor, name);
  TORCH_CHECK(tensor.scalar_type() == at::kLong && tensor.dim() == 2, name,
              " must be an int64 rank-2 tensor");
}

void check_i64_vector(const at::Tensor& tensor, const char* name) {
  check_xpu_contiguous(tensor, name);
  TORCH_CHECK(tensor.scalar_type() == at::kLong && tensor.dim() == 1, name,
              " must be an int64 rank-1 tensor");
}

at::Tensor metadata_storage(const at::Tensor& reference, size_t bytes) {
  return at::empty({static_cast<int64_t>(bytes)},
                   reference.options().dtype(at::kByte).requires_grad(false));
}

template <class T>
T* metadata_ptr(at::Tensor& storage) {
  return reinterpret_cast<T*>(storage.data_ptr<uint8_t>());
}

sycl::queue& current_queue(const at::Tensor& tensor) {
  return c10::xpu::getCurrentXPUStream(tensor.get_device()).queue();
}

void record_current_stream(const at::Tensor& tensor) {
  tensor.record_stream(c10::xpu::getCurrentXPUStream(tensor.get_device()).unwrap());
}

int stream_slice_count(sycl::queue& queue) {
  const auto device = queue.get_device();
  const auto slices = device.get_info<sycl::ext::intel::info::device::gpu_slices>();
  const auto subslices =
      device.get_info<sycl::ext::intel::info::device::gpu_subslices_per_slice>();
  return static_cast<int>(slices * subslices);
}

auto gemm_linear_fusion_args() {
  auto args = decltype(Gemm::Arguments{}.epilogue.thread){};
  args.alpha = 1.0f;
  args.beta = 0.0f;
  args.alpha_ptr = nullptr;
  args.beta_ptr = nullptr;
  args.alpha_ptr_array = nullptr;
  args.beta_ptr_array = nullptr;
  args.dAlpha = {cute::_0{}, cute::_0{}, 0};
  args.dBeta = {cute::_0{}, cute::_0{}, 0};
  return args;
}

auto weight_grad_linear_fusion_args() {
  auto args = decltype(WeightGradGemm::Arguments{}.epilogue.thread){};
  args.alpha = 1.0f;
  args.beta = 0.0f;
  args.alpha_ptr = nullptr;
  args.beta_ptr = nullptr;
  args.alpha_ptr_array = nullptr;
  args.beta_ptr_array = nullptr;
  args.dAlpha = {cute::_0{}, cute::_0{}, 0};
  args.dBeta = {cute::_0{}, cute::_0{}, 0};
  return args;
}

struct SegmentInputs {
  const int32_t* counts;
  const int64_t* source_expert_offsets;
  const int64_t* source_offsets;
  int32_t sources;
  int32_t experts;
};

SegmentInputs check_segments(const at::Tensor& source_expert_counts,
                             const at::Tensor& source_expert_offsets,
                             const at::Tensor& source_offsets,
                             const at::Tensor& reference) {
  check_i32_matrix(source_expert_counts, "source_expert_counts");
  check_i64_matrix(source_expert_offsets, "source_expert_offsets");
  check_i64_vector(source_offsets, "source_offsets");
  TORCH_CHECK(source_expert_counts.device() == reference.device() &&
                  source_expert_offsets.device() == reference.device() &&
                  source_offsets.device() == reference.device(),
              "segment metadata must share the activation device");
  const int64_t sources = source_expert_counts.size(0);
  const int64_t experts = source_expert_counts.size(1);
  TORCH_CHECK(sources > 0 && experts > 0, "segment metadata needs positive source and expert counts");
  TORCH_CHECK(source_expert_offsets.size(0) == sources &&
                  source_expert_offsets.size(1) == experts + 1,
              "source_expert_offsets must have shape [sources, experts + 1]");
  TORCH_CHECK(source_offsets.numel() == sources + 1,
              "source_offsets must have one more entry than sources");
  TORCH_CHECK(sources * experts <= std::numeric_limits<int32_t>::max(),
              "source/expert group count exceeds int32 limits");
  return {source_expert_counts.data_ptr<int32_t>(),
          source_expert_offsets.data_ptr<int64_t>(),
          source_offsets.data_ptr<int64_t>(), static_cast<int32_t>(sources),
          static_cast<int32_t>(experts)};
}

}  // namespace

at::Tensor segmented_grouped_gemm_bf16(
    const at::Tensor& activations, const at::Tensor& weights,
    const at::Tensor& source_expert_counts,
    const at::Tensor& source_expert_offsets,
    const at::Tensor& source_offsets) {
  check_bf16_matrix(activations, "activations", 2);
  check_bf16_matrix(weights, "weights", 3);
  TORCH_CHECK(activations.device() == weights.device(),
              "activations and weights must share an XPU device");
  const auto segments = check_segments(
      source_expert_counts, source_expert_offsets, source_offsets, activations);
  const int64_t routes = activations.size(0);
  const int64_t k = activations.size(1);
  const int64_t n = weights.size(2);
  TORCH_CHECK(weights.size(0) == segments.experts,
              "weight expert count must equal segment expert count");
  TORCH_CHECK(weights.size(1) == k && k > 0 && n > 0,
              "activation and weight dimensions must be positive and match");
  TORCH_CHECK(n % 8 == 0,
              "the SYCL*TLA BF16 epilogue requires N divisible by 8");
  TORCH_CHECK(routes <= std::numeric_limits<int32_t>::max() &&
                  k <= std::numeric_limits<int32_t>::max() &&
                  n <= std::numeric_limits<int32_t>::max(),
              "segmented GEMM extents exceed int32 limits");

  auto output = at::empty({routes, n}, activations.options());
  if (routes == 0) {
    return output;
  }
  const int32_t groups = segments.sources * segments.experts;
  auto problem_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(UnderlyingProblemShape));
  auto a_pointer_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(const Element*));
  auto b_pointer_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(const Element*));
  auto c_pointer_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(const Element*));
  auto d_pointer_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(Element*));
  auto a_stride_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(StrideA));
  auto b_stride_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(StrideB));
  auto c_stride_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(StrideC));
  auto d_stride_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(StrideD));

  auto* shapes = metadata_ptr<UnderlyingProblemShape>(problem_storage);
  auto* a_ptrs = metadata_ptr<const Element*>(a_pointer_storage);
  auto* b_ptrs = metadata_ptr<const Element*>(b_pointer_storage);
  auto* c_ptrs = metadata_ptr<const Element*>(c_pointer_storage);
  auto* d_ptrs = metadata_ptr<Element*>(d_pointer_storage);
  auto* a_strides = metadata_ptr<StrideA>(a_stride_storage);
  auto* b_strides = metadata_ptr<StrideB>(b_stride_storage);
  auto* c_strides = metadata_ptr<StrideC>(c_stride_storage);
  auto* d_strides = metadata_ptr<StrideD>(d_stride_storage);
  const auto* a = reinterpret_cast<const Element*>(activations.data_ptr());
  const auto* b = reinterpret_cast<const Element*>(weights.data_ptr());
  auto* d = reinterpret_cast<Element*>(output.data_ptr());
  const int32_t k_i32 = static_cast<int32_t>(k);
  const int32_t n_i32 = static_cast<int32_t>(n);
  auto& queue = current_queue(activations);
  const auto metadata_ready = queue.parallel_for<BuildSegmentedMetadataKernel>(
      sycl::range<1>(static_cast<size_t>(groups)), [=](sycl::id<1> index) {
        const int32_t group = static_cast<int32_t>(index[0]);
        const int32_t source = group / segments.experts;
        const int32_t expert = group - source * segments.experts;
        const int32_t rows = segments.counts[group];
        const int64_t begin = segments.source_offsets[source] +
            segments.source_expert_offsets[source * (segments.experts + 1) + expert];
        shapes[group] = UnderlyingProblemShape{rows, n_i32, k_i32};
        a_ptrs[group] = a + begin * k_i32;
        b_ptrs[group] = b + static_cast<int64_t>(expert) * k_i32 * n_i32;
        c_ptrs[group] = d + begin * n_i32;
        d_ptrs[group] = d + begin * n_i32;
        a_strides[group] = cutlass::make_cute_packed_stride(
            StrideA{}, cute::make_shape(rows, k_i32, 1));
        b_strides[group] = cutlass::make_cute_packed_stride(
            StrideB{}, cute::make_shape(n_i32, k_i32, 1));
        c_strides[group] = cutlass::make_cute_packed_stride(
            StrideC{}, cute::make_shape(rows, n_i32, 1));
        d_strides[group] = cutlass::make_cute_packed_stride(
            StrideD{}, cute::make_shape(rows, n_i32, 1));
      });
  queue.ext_oneapi_submit_barrier({metadata_ready});

  const int slices = stream_slice_count(queue);
  TORCH_CHECK(slices > 0, "the current XPU stream reports no GPU slices");
  cutlass::KernelHardwareInfo hardware{activations.get_device(), slices};
  typename Gemm::Arguments args{
      cutlass::gemm::GemmUniversalMode::kGrouped,
      {groups, shapes, nullptr},
      {a_ptrs, a_strides, b_ptrs, b_strides},
      {gemm_linear_fusion_args(), c_ptrs, c_strides, d_ptrs, d_strides},
      hardware,
      {1, RasterOrderOptions::AlongN}};
  Gemm gemm;
  const auto initialize_status = gemm.initialize(args, nullptr, &queue);
  TORCH_CHECK(initialize_status == cutlass::Status::kSuccess,
              "segmented SYCL*TLA GEMM initialization failed with status ",
              static_cast<int>(initialize_status));
  const auto run_status = gemm.run(&queue);
  TORCH_CHECK(run_status == cutlass::Status::kSuccess,
              "segmented SYCL*TLA GEMM launch failed with status ",
              static_cast<int>(run_status));
  for (const auto& tensor : {activations, weights, source_expert_counts,
                             source_expert_offsets, source_offsets, output,
                             problem_storage, a_pointer_storage, b_pointer_storage,
                             c_pointer_storage, d_pointer_storage, a_stride_storage,
                             b_stride_storage, c_stride_storage, d_stride_storage}) {
    record_current_stream(tensor);
  }
  return output;
}

at::Tensor segmented_weight_grad_bf16(
    const at::Tensor& activations, const at::Tensor& grad_output,
    const at::Tensor& source_expert_counts,
    const at::Tensor& source_expert_offsets,
    const at::Tensor& source_offsets) {
  check_bf16_matrix(activations, "activations", 2);
  check_bf16_matrix(grad_output, "grad_output", 2);
  TORCH_CHECK(activations.device() == grad_output.device() &&
                  activations.size(0) == grad_output.size(0),
              "activation and gradient rows must share one XPU device");
  const auto segments = check_segments(
      source_expert_counts, source_expert_offsets, source_offsets, activations);
  const int64_t routes = activations.size(0);
  const int64_t input_dim = activations.size(1);
  const int64_t output_dim = grad_output.size(1);
  TORCH_CHECK(input_dim > 0 && output_dim > 0 && output_dim % 8 == 0,
              "segmented dW dimensions must be positive and output divisible by 8");
  TORCH_CHECK(routes <= std::numeric_limits<int32_t>::max() &&
                  input_dim <= std::numeric_limits<int32_t>::max() &&
                  output_dim <= std::numeric_limits<int32_t>::max(),
              "segmented dW extents exceed int32 limits");
  auto output = at::empty({segments.experts, input_dim, output_dim}, activations.options());
  if (routes == 0) {
    output.zero_();
    return output;
  }
  const int32_t groups = segments.sources * segments.experts;
  // The expert-major caller has already compacted all physical source
  // fragments into one true-length interval per expert.  In that common case
  // the grouped GEMM's output layout is exactly the final [expert, D, N]
  // layout, so a separate partial tensor and a bandwidth-only reduction are
  // unnecessary.  Retain the original partial/reduce path for an arbitrary
  // number of physical sources; this is a runtime layout choice, not a shape
  // specialization or capacity assumption.
  const bool direct_expert_output = segments.sources == 1;
  auto partial = direct_expert_output
      ? output
      : at::empty({groups, input_dim, output_dim}, activations.options());
  auto problem_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(UnderlyingProblemShape));
  auto a_pointer_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(const Element*));
  auto b_pointer_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(const Element*));
  auto c_pointer_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(const Element*));
  auto d_pointer_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(Element*));
  auto a_stride_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(WeightGradStrideA));
  auto b_stride_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(WeightGradStrideB));
  auto c_stride_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(WeightGradStrideC));
  auto d_stride_storage = metadata_storage(
      activations, static_cast<size_t>(groups) * sizeof(WeightGradStrideD));

  auto* shapes = metadata_ptr<UnderlyingProblemShape>(problem_storage);
  auto* a_ptrs = metadata_ptr<const Element*>(a_pointer_storage);
  auto* b_ptrs = metadata_ptr<const Element*>(b_pointer_storage);
  auto* c_ptrs = metadata_ptr<const Element*>(c_pointer_storage);
  auto* d_ptrs = metadata_ptr<Element*>(d_pointer_storage);
  auto* a_strides = metadata_ptr<WeightGradStrideA>(a_stride_storage);
  auto* b_strides = metadata_ptr<WeightGradStrideB>(b_stride_storage);
  auto* c_strides = metadata_ptr<WeightGradStrideC>(c_stride_storage);
  auto* d_strides = metadata_ptr<WeightGradStrideD>(d_stride_storage);
  const auto* a = reinterpret_cast<const Element*>(activations.data_ptr());
  const auto* b = reinterpret_cast<const Element*>(grad_output.data_ptr());
  auto* partial_ptr = reinterpret_cast<Element*>(partial.data_ptr());
  const int32_t input_i32 = static_cast<int32_t>(input_dim);
  const int32_t output_i32 = static_cast<int32_t>(output_dim);
  auto& queue = current_queue(activations);
  const auto metadata_ready = queue.parallel_for<BuildSegmentedWeightGradMetadataKernel>(
      sycl::range<1>(static_cast<size_t>(groups)), [=](sycl::id<1> index) {
        const int32_t group = static_cast<int32_t>(index[0]);
        const int32_t source = group / segments.experts;
        const int32_t expert = group - source * segments.experts;
        const int32_t rows = segments.counts[group];
        const int64_t begin = segments.source_offsets[source] +
            segments.source_expert_offsets[source * (segments.experts + 1) + expert];
        shapes[group] = UnderlyingProblemShape{input_i32, output_i32, rows};
        a_ptrs[group] = a + begin * input_i32;
        b_ptrs[group] = b + begin * output_i32;
        c_ptrs[group] = partial_ptr + static_cast<int64_t>(group) * input_i32 * output_i32;
        d_ptrs[group] = partial_ptr + static_cast<int64_t>(group) * input_i32 * output_i32;
        a_strides[group] = cutlass::make_cute_packed_stride(
            WeightGradStrideA{}, cute::make_shape(input_i32, rows, 1));
        b_strides[group] = cutlass::make_cute_packed_stride(
            WeightGradStrideB{}, cute::make_shape(output_i32, rows, 1));
        c_strides[group] = cutlass::make_cute_packed_stride(
            WeightGradStrideC{}, cute::make_shape(input_i32, output_i32, 1));
        d_strides[group] = cutlass::make_cute_packed_stride(
            WeightGradStrideD{}, cute::make_shape(input_i32, output_i32, 1));
      });
  queue.ext_oneapi_submit_barrier({metadata_ready});

  const int slices = stream_slice_count(queue);
  TORCH_CHECK(slices > 0, "the current XPU stream reports no GPU slices");
  cutlass::KernelHardwareInfo hardware{activations.get_device(), slices};
  typename WeightGradGemm::Arguments args{
      cutlass::gemm::GemmUniversalMode::kGrouped,
      {groups, shapes, nullptr},
      {a_ptrs, a_strides, b_ptrs, b_strides},
      {weight_grad_linear_fusion_args(), c_ptrs, c_strides, d_ptrs, d_strides},
      hardware,
      {1, RasterOrderOptions::AlongN}};
  WeightGradGemm gemm;
  const auto initialize_status = gemm.initialize(args, nullptr, &queue);
  TORCH_CHECK(initialize_status == cutlass::Status::kSuccess,
              "segmented SYCL*TLA dW initialization failed with status ",
              static_cast<int>(initialize_status));
  const auto run_status = gemm.run(&queue);
  TORCH_CHECK(run_status == cutlass::Status::kSuccess,
              "segmented SYCL*TLA dW launch failed with status ",
              static_cast<int>(run_status));

  if (!direct_expert_output) {
    const auto* partial_data = reinterpret_cast<const Element*>(partial.data_ptr());
    auto* output_data = reinterpret_cast<Element*>(output.data_ptr());
    const int64_t plane = input_dim * output_dim;
    // TLA's grouped GEMM is submitted directly to the current SYCL queue.
    // Make the reduction dependency explicit because the PyTorch stream may be
    // backed by an out-of-order queue; relying on submission order here can
    // expose partially written dW fragments under stream overlap.
    const auto gemm_complete = queue.ext_oneapi_submit_barrier();
    queue.submit([&](sycl::handler& cgh) {
      cgh.depends_on(gemm_complete);
      cgh.parallel_for<ReduceSegmentedWeightGradKernel>(
          sycl::range<1>(static_cast<size_t>(segments.experts * plane)),
          [=](sycl::id<1> index) {
            const int64_t flat = static_cast<int64_t>(index[0]);
            const int32_t expert = static_cast<int32_t>(flat / plane);
            const int64_t element = flat - static_cast<int64_t>(expert) * plane;
            float sum = 0.0f;
            for (int32_t source = 0; source < segments.sources; ++source) {
              const int32_t group = source * segments.experts + expert;
              if (segments.counts[group] != 0) {
                sum += static_cast<float>(
                    partial_data[static_cast<int64_t>(group) * plane + element]);
              }
            }
            output_data[flat] = Element(sum);
          });
    });
  }
  for (const auto& tensor : {activations, grad_output, source_expert_counts,
                             source_expert_offsets, source_offsets, partial, output,
                             problem_storage, a_pointer_storage, b_pointer_storage,
                             c_pointer_storage, d_pointer_storage, a_stride_storage,
                             b_stride_storage, c_stride_storage, d_stride_storage}) {
    record_current_stream(tensor);
  }
  return output;
}

}  // namespace aurora_moe

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module) {
  module.def("segmented_grouped_gemm_bf16", &aurora_moe::segmented_grouped_gemm_bf16,
             "Exact source/expert segmented BF16 grouped GEMM on XPU");
  module.def("segmented_weight_grad_bf16", &aurora_moe::segmented_weight_grad_bf16,
             "Exact source/expert segmented BF16 grouped dW on XPU");
}
