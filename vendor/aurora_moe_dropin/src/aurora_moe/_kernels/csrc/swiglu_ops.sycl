// Generic BF16 SwiGLU pointwise kernels for the Aurora MoE prototype.

#include <ATen/ATen.h>
#include <c10/xpu/XPUStream.h>
#include <sycl/sycl.hpp>
#include <torch/extension.h>

#include <cstdint>
#include <tuple>

namespace aurora_moe {
namespace {

using bf16 = sycl::ext::oneapi::bfloat16;

class SwiGluForwardKernel;
class SwiGluBackwardKernel;

void check_bf16_xpu_contiguous(const at::Tensor& tensor, const char* name) {
  TORCH_CHECK(tensor.device().type() == c10::DeviceType::XPU, name,
              " must be an XPU tensor");
  TORCH_CHECK(tensor.is_contiguous(), name, " must be contiguous");
  TORCH_CHECK(tensor.scalar_type() == at::kBFloat16, name,
              " must have dtype torch.bfloat16");
}

sycl::queue& current_queue(const at::Tensor& tensor) {
  return c10::xpu::getCurrentXPUStream(tensor.get_device()).queue();
}

}  // namespace

at::Tensor swiglu_forward_bf16(const at::Tensor& up, const at::Tensor& gate) {
  check_bf16_xpu_contiguous(up, "up");
  check_bf16_xpu_contiguous(gate, "gate");
  TORCH_CHECK(up.sizes() == gate.sizes(), "up and gate must have the same shape");
  TORCH_CHECK(up.device() == gate.device(), "up and gate must share an XPU device");
  auto hidden = at::empty_like(up);
  const int64_t elements = up.numel();
  if (elements == 0) {
    return hidden;
  }
  const auto* up_ptr = reinterpret_cast<const bf16*>(up.data_ptr());
  const auto* gate_ptr = reinterpret_cast<const bf16*>(gate.data_ptr());
  auto* hidden_ptr = reinterpret_cast<bf16*>(hidden.data_ptr());
  current_queue(up).parallel_for<SwiGluForwardKernel>(
      sycl::range<1>(static_cast<size_t>(elements)), [=](sycl::id<1> id) {
        const int64_t index = static_cast<int64_t>(id[0]);
        const float g = static_cast<float>(gate_ptr[index]);
        const float sigmoid = 1.0f / (1.0f + sycl::exp(-g));
        hidden_ptr[index] = bf16(static_cast<float>(up_ptr[index]) * g * sigmoid);
      });
  return hidden;
}

std::tuple<at::Tensor, at::Tensor> swiglu_backward_bf16(
    const at::Tensor& grad_hidden, const at::Tensor& up, const at::Tensor& gate) {
  check_bf16_xpu_contiguous(grad_hidden, "grad_hidden");
  check_bf16_xpu_contiguous(up, "up");
  check_bf16_xpu_contiguous(gate, "gate");
  TORCH_CHECK(grad_hidden.sizes() == up.sizes() && up.sizes() == gate.sizes(),
              "grad_hidden, up, and gate must have the same shape");
  TORCH_CHECK(grad_hidden.device() == up.device() && up.device() == gate.device(),
              "all SwiGLU backward inputs must share an XPU device");
  auto grad_up = at::empty_like(up);
  auto grad_gate = at::empty_like(gate);
  const int64_t elements = up.numel();
  if (elements == 0) {
    return {grad_up, grad_gate};
  }
  const auto* grad_hidden_ptr = reinterpret_cast<const bf16*>(grad_hidden.data_ptr());
  const auto* up_ptr = reinterpret_cast<const bf16*>(up.data_ptr());
  const auto* gate_ptr = reinterpret_cast<const bf16*>(gate.data_ptr());
  auto* grad_up_ptr = reinterpret_cast<bf16*>(grad_up.data_ptr());
  auto* grad_gate_ptr = reinterpret_cast<bf16*>(grad_gate.data_ptr());
  current_queue(grad_hidden).parallel_for<SwiGluBackwardKernel>(
      sycl::range<1>(static_cast<size_t>(elements)), [=](sycl::id<1> id) {
        const int64_t index = static_cast<int64_t>(id[0]);
        const float dh = static_cast<float>(grad_hidden_ptr[index]);
        const float u = static_cast<float>(up_ptr[index]);
        const float g = static_cast<float>(gate_ptr[index]);
        const float sigmoid = 1.0f / (1.0f + sycl::exp(-g));
        grad_up_ptr[index] = bf16(dh * g * sigmoid);
        grad_gate_ptr[index] =
            bf16(dh * u * sigmoid * (1.0f + g * (1.0f - sigmoid)));
      });
  return {grad_up, grad_gate};
}

}  // namespace aurora_moe

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module) {
  module.def("swiglu_forward_bf16", &aurora_moe::swiglu_forward_bf16,
             "Fused BF16 SwiGLU forward on XPU");
  module.def("swiglu_backward_bf16", &aurora_moe::swiglu_backward_bf16,
             "Fused BF16 SwiGLU backward pointwise on XPU");
}
