//
// Exact conversion between source-major padded EP rows and dynamic
// expert-major BMM rows.  The layout is driven only by received counts and
// local expert IDs; it has no configured capacity or fixed model dimensions.

#include <ATen/ATen.h>
#include <c10/xpu/XPUStream.h>
#include <pybind11/stl.h>
#include <sycl/sycl.hpp>
#include <torch/extension.h>

#include <cstdint>
#include <vector>

namespace aurora_moe {

namespace {

using bf16 = sycl::ext::oneapi::bfloat16;

constexpr size_t kThreads = 256;
constexpr int64_t kRowsPerWorkgroup = 4;

using AtomicCounter = sycl::atomic_ref<
    int32_t, sycl::memory_order::relaxed, sycl::memory_scope::device,
    sycl::access::address_space::global_space>;

class CountPaddedIdsKernel;
class CountPaddedPayloadIdsKernel;
class PackPaddedIdsKernel;
class PackPaddedPayloadIdsKernel;
class PaddedToExpertKernel;
class ExpertToPaddedKernel;
class WeightedExpertToPaddedKernel;
class ExpertTokenScoreToPaddedKernel;
class ZeroExpertRowTailsKernel;

void check_xpu_contiguous(const at::Tensor& tensor, const char* name) {
  TORCH_CHECK(tensor.device().type() == c10::DeviceType::XPU, name,
              " must be an XPU tensor");
  TORCH_CHECK(tensor.is_contiguous(), name, " must be contiguous");
}

void check_bf16_matrix(const at::Tensor& tensor, const char* name) {
  check_xpu_contiguous(tensor, name);
  TORCH_CHECK(tensor.scalar_type() == at::kBFloat16, name,
              " must have dtype torch.bfloat16");
  TORCH_CHECK(tensor.dim() == 2, name, " must be rank 2");
}

void check_i64_vector(const at::Tensor& tensor, const char* name) {
  check_xpu_contiguous(tensor, name);
  TORCH_CHECK(tensor.scalar_type() == at::kLong, name,
              " must have dtype torch.int64");
  TORCH_CHECK(tensor.dim() == 1, name, " must be rank 1");
}

void check_i32_vector(const at::Tensor& tensor, const char* name) {
  check_xpu_contiguous(tensor, name);
  TORCH_CHECK(tensor.scalar_type() == at::kInt, name,
              " must have dtype torch.int32");
  TORCH_CHECK(tensor.dim() == 1, name, " must be rank 1");
}

void check_counts(const at::Tensor& counts) {
  check_i64_vector(counts, "recv_counts");
}

void check_padded_rows(const at::Tensor& values, const at::Tensor& counts,
                       int64_t cap) {
  TORCH_CHECK(cap >= 0, "cap must be nonnegative");
  TORCH_CHECK(values.size(0) == counts.numel() * cap,
              "padded rows must equal recv_counts.numel() * cap");
}

void check_expert_shape(int64_t experts, int64_t max_rows) {
  TORCH_CHECK(experts > 0, "num_experts must be positive");
  TORCH_CHECK(max_rows >= 0, "max_rows must be nonnegative");
}

sycl::queue& current_queue(const at::Tensor& tensor) {
  return c10::xpu::getCurrentXPUStream(tensor.get_device()).queue();
}

inline bool is_valid_padded_row(int64_t row, const int64_t* counts,
                                int64_t cap) {
  return row % cap < counts[row / cap];
}

}  // namespace

// Count each valid source-major padded route by its separate int64 local
// expert ID.  Invalid padded rows are governed by recv_counts and never read.
at::Tensor count_padded_expert_ids_i64(const at::Tensor& local_ids,
                                       const at::Tensor& recv_counts,
                                       int64_t cap,
                                       int64_t num_experts) {
  check_i64_vector(local_ids, "local_ids");
  check_counts(recv_counts);
  check_expert_shape(num_experts, 0);
  TORCH_CHECK(local_ids.device() == recv_counts.device(),
              "local_ids and recv_counts must share an XPU device");
  check_padded_rows(local_ids, recv_counts, cap);
  auto output = at::zeros({num_experts}, local_ids.options().dtype(at::kInt));
  const int64_t padded_rows = local_ids.numel();
  if (padded_rows == 0) {
    return output;
  }
  const auto* ids = local_ids.data_ptr<int64_t>();
  const auto* counts = recv_counts.data_ptr<int64_t>();
  auto* out = output.data_ptr<int32_t>();
  auto& queue = current_queue(local_ids);
  queue.parallel_for<CountPaddedIdsKernel>(
      sycl::range<1>(static_cast<size_t>(padded_rows)),
      [=](sycl::id<1> index) {
        const int64_t row = static_cast<int64_t>(index[0]);
        if (!is_valid_padded_row(row, counts, cap)) {
          return;
        }
        AtomicCounter counter(out[ids[row]]);
        counter.fetch_add(1);
      });
  return output;
}

// Count exact-small local IDs carried in the final BF16 payload column.  BF16
// IDs are intentionally limited to [0, 255], while the separate-ID path
// above remains the generic arbitrary-expert-count implementation.
at::Tensor count_padded_payload_expert_ids_bf16(
    const at::Tensor& payload, const at::Tensor& recv_counts, int64_t cap,
    int64_t num_experts) {
  check_bf16_matrix(payload, "payload");
  check_counts(recv_counts);
  check_expert_shape(num_experts, 0);
  TORCH_CHECK(num_experts <= 256,
              "BF16 payload IDs require num_experts in [1, 256]");
  TORCH_CHECK(payload.device() == recv_counts.device(),
              "payload and recv_counts must share an XPU device");
  TORCH_CHECK(payload.size(1) >= 3,
              "payload must contain token columns, score, and local ID");
  check_padded_rows(payload, recv_counts, cap);
  auto output = at::zeros({num_experts}, payload.options().dtype(at::kInt));
  const int64_t padded_rows = payload.size(0);
  if (padded_rows == 0) {
    return output;
  }
  const int64_t stride = payload.size(1);
  const auto* input = reinterpret_cast<const bf16*>(payload.data_ptr());
  const auto* counts = recv_counts.data_ptr<int64_t>();
  auto* out = output.data_ptr<int32_t>();
  auto& queue = current_queue(payload);
  queue.parallel_for<CountPaddedPayloadIdsKernel>(
      sycl::range<1>(static_cast<size_t>(padded_rows)),
      [=](sycl::id<1> index) {
        const int64_t row = static_cast<int64_t>(index[0]);
        if (!is_valid_padded_row(row, counts, cap)) {
          return;
        }
        const int64_t expert = static_cast<int64_t>(
            static_cast<float>(input[row * stride + stride - 1]));
        AtomicCounter counter(out[expert]);
        counter.fetch_add(1);
      });
  return output;
}

// Convert a padded [token..., score] payload directly to exact dynamic
// [expert, max_rows, ...] tensors.  source_slots is indexed by padded source
// row; entries corresponding to padding are undefined and must be guarded by
// recv_counts by consumers.
std::vector<at::Tensor> pack_padded_payload_ids_i64_to_expert_bf16(
    const at::Tensor& payload, const at::Tensor& local_ids,
    const at::Tensor& recv_counts, int64_t cap, int64_t num_experts,
    int64_t max_rows, bool zero_initialize) {
  check_bf16_matrix(payload, "payload");
  check_i64_vector(local_ids, "local_ids");
  check_counts(recv_counts);
  check_expert_shape(num_experts, max_rows);
  TORCH_CHECK(payload.device() == local_ids.device() &&
                  payload.device() == recv_counts.device(),
              "payload, local_ids, and recv_counts must share an XPU device");
  TORCH_CHECK(payload.size(1) >= 2,
              "payload must contain token columns and one score column");
  check_padded_rows(payload, recv_counts, cap);
  TORCH_CHECK(local_ids.numel() == payload.size(0),
              "local_ids must provide one ID per padded payload row");
  const int64_t padded_rows = payload.size(0);
  const int64_t columns = payload.size(1) - 1;
  auto tokens = zero_initialize
      ? at::zeros({num_experts, max_rows, columns}, payload.options())
      : at::empty({num_experts, max_rows, columns}, payload.options());
  auto scores = zero_initialize
      ? at::zeros({num_experts, max_rows}, payload.options())
      : at::empty({num_experts, max_rows}, payload.options());
  auto source_slots = at::empty_like(local_ids);
  auto counters = at::zeros({num_experts}, local_ids.options().dtype(at::kInt));
  if (padded_rows == 0 || max_rows == 0) {
    return {tokens, scores, source_slots};
  }
  const int64_t stride = columns + 1;
  const auto* input = reinterpret_cast<const bf16*>(payload.data_ptr());
  const auto* ids = local_ids.data_ptr<int64_t>();
  const auto* counts = recv_counts.data_ptr<int64_t>();
  auto* token_out = reinterpret_cast<bf16*>(tokens.data_ptr());
  auto* score_out = reinterpret_cast<bf16*>(scores.data_ptr());
  auto* slots_out = source_slots.data_ptr<int64_t>();
  auto* counter_data = counters.data_ptr<int32_t>();
  auto& queue = current_queue(payload);
  const size_t groups = static_cast<size_t>(
      (padded_rows + kRowsPerWorkgroup - 1) / kRowsPerWorkgroup);
  queue.submit([&](sycl::handler& cgh) {
    sycl::local_accessor<int64_t, 1> expert_slots(
        sycl::range<1>(kRowsPerWorkgroup), cgh);
    cgh.parallel_for<PackPaddedIdsKernel>(
        sycl::nd_range<1>(sycl::range<1>(groups * kThreads),
                          sycl::range<1>(kThreads)),
        [=](sycl::nd_item<1> item) {
          const int64_t base_row =
              static_cast<int64_t>(item.get_group(0)) * kRowsPerWorkgroup;
          const int64_t lane = static_cast<int64_t>(item.get_local_id(0));
          if (lane < kRowsPerWorkgroup) {
            const int64_t row = base_row + lane;
            int64_t slot = -1;
            if (row < padded_rows && is_valid_padded_row(row, counts, cap)) {
              const int64_t expert = ids[row];
              AtomicCounter counter(counter_data[expert]);
              const int32_t expert_row = counter.fetch_add(1);
              slot = expert * max_rows + static_cast<int64_t>(expert_row);
              slots_out[row] = slot;
            }
            expert_slots[lane] = slot;
          }
          item.barrier(sycl::access::fence_space::local_space);
          for (int64_t row = base_row;
               row < base_row + kRowsPerWorkgroup && row < padded_rows; ++row) {
            const int64_t slot = expert_slots[row - base_row];
            if (slot < 0) {
              continue;
            }
            for (int64_t column = lane; column < columns;
                 column += static_cast<int64_t>(kThreads)) {
              token_out[slot * columns + column] = input[row * stride + column];
            }
            if (lane == 0) {
              score_out[slot] = input[row * stride + columns];
            }
          }
        });
  });
  return {tokens, scores, source_slots};
}

// BF16-small-ID equivalent of pack_padded_payload_ids_i64_to_expert_bf16.
// The final payload columns are [score, local_id].
std::vector<at::Tensor> pack_padded_payload_ids_bf16_to_expert_bf16(
    const at::Tensor& payload, const at::Tensor& recv_counts, int64_t cap,
    int64_t num_experts, int64_t max_rows, bool zero_initialize) {
  check_bf16_matrix(payload, "payload");
  check_counts(recv_counts);
  check_expert_shape(num_experts, max_rows);
  TORCH_CHECK(num_experts <= 256,
              "BF16 payload IDs require num_experts in [1, 256]");
  TORCH_CHECK(payload.device() == recv_counts.device(),
              "payload and recv_counts must share an XPU device");
  TORCH_CHECK(payload.size(1) >= 3,
              "payload must contain token columns, score, and local ID");
  check_padded_rows(payload, recv_counts, cap);
  const int64_t padded_rows = payload.size(0);
  const int64_t columns = payload.size(1) - 2;
  auto tokens = zero_initialize
      ? at::zeros({num_experts, max_rows, columns}, payload.options())
      : at::empty({num_experts, max_rows, columns}, payload.options());
  auto scores = zero_initialize
      ? at::zeros({num_experts, max_rows}, payload.options())
      : at::empty({num_experts, max_rows}, payload.options());
  auto source_slots = at::empty({padded_rows}, payload.options().dtype(at::kLong));
  auto counters = at::zeros({num_experts}, payload.options().dtype(at::kInt));
  if (padded_rows == 0 || max_rows == 0) {
    return {tokens, scores, source_slots};
  }
  const int64_t stride = columns + 2;
  const auto* input = reinterpret_cast<const bf16*>(payload.data_ptr());
  const auto* counts = recv_counts.data_ptr<int64_t>();
  auto* token_out = reinterpret_cast<bf16*>(tokens.data_ptr());
  auto* score_out = reinterpret_cast<bf16*>(scores.data_ptr());
  auto* slots_out = source_slots.data_ptr<int64_t>();
  auto* counter_data = counters.data_ptr<int32_t>();
  auto& queue = current_queue(payload);
  const size_t groups = static_cast<size_t>(
      (padded_rows + kRowsPerWorkgroup - 1) / kRowsPerWorkgroup);
  queue.submit([&](sycl::handler& cgh) {
    sycl::local_accessor<int64_t, 1> expert_slots(
        sycl::range<1>(kRowsPerWorkgroup), cgh);
    cgh.parallel_for<PackPaddedPayloadIdsKernel>(
        sycl::nd_range<1>(sycl::range<1>(groups * kThreads),
                          sycl::range<1>(kThreads)),
        [=](sycl::nd_item<1> item) {
          const int64_t base_row =
              static_cast<int64_t>(item.get_group(0)) * kRowsPerWorkgroup;
          const int64_t lane = static_cast<int64_t>(item.get_local_id(0));
          if (lane < kRowsPerWorkgroup) {
            const int64_t row = base_row + lane;
            int64_t slot = -1;
            if (row < padded_rows && is_valid_padded_row(row, counts, cap)) {
              const int64_t expert = static_cast<int64_t>(
                  static_cast<float>(input[row * stride + columns + 1]));
              AtomicCounter counter(counter_data[expert]);
              const int32_t expert_row = counter.fetch_add(1);
              slot = expert * max_rows + static_cast<int64_t>(expert_row);
              slots_out[row] = slot;
            }
            expert_slots[lane] = slot;
          }
          item.barrier(sycl::access::fence_space::local_space);
          for (int64_t row = base_row;
               row < base_row + kRowsPerWorkgroup && row < padded_rows; ++row) {
            const int64_t slot = expert_slots[row - base_row];
            if (slot < 0) {
              continue;
            }
            for (int64_t column = lane; column < columns;
                 column += static_cast<int64_t>(kThreads)) {
              token_out[slot * columns + column] = input[row * stride + column];
            }
            if (lane == 0) {
              score_out[slot] = input[row * stride + columns];
            }
          }
        });
  });
  return {tokens, scores, source_slots};
}

// Map padded source-major vector rows into the expert-major layout recorded
// by source_slots.  This is the backward companion to the direct payload
// pack; every valid source row owns a unique expert destination row.
at::Tensor padded_rows_to_expert_bf16(const at::Tensor& values,
                                      const at::Tensor& source_slots,
                                      const at::Tensor& recv_counts,
                                      int64_t cap,
                                      int64_t num_experts,
                                      int64_t max_rows,
                                      bool zero_initialize) {
  check_bf16_matrix(values, "values");
  check_i64_vector(source_slots, "source_slots");
  check_counts(recv_counts);
  check_expert_shape(num_experts, max_rows);
  TORCH_CHECK(values.device() == source_slots.device() &&
                  values.device() == recv_counts.device(),
              "values, source_slots, and recv_counts must share an XPU device");
  check_padded_rows(values, recv_counts, cap);
  TORCH_CHECK(source_slots.numel() == values.size(0),
              "source_slots must provide one slot per padded row");
  const int64_t padded_rows = values.size(0);
  const int64_t columns = values.size(1);
  auto output = zero_initialize
      ? at::zeros({num_experts, max_rows, columns}, values.options())
      : at::empty({num_experts, max_rows, columns}, values.options());
  if (padded_rows == 0 || max_rows == 0 || columns == 0) {
    return output;
  }
  const auto* input = reinterpret_cast<const bf16*>(values.data_ptr());
  const auto* slots = source_slots.data_ptr<int64_t>();
  const auto* counts = recv_counts.data_ptr<int64_t>();
  auto* out = reinterpret_cast<bf16*>(output.data_ptr());
  auto& queue = current_queue(values);
  const size_t groups = static_cast<size_t>(
      (padded_rows + kRowsPerWorkgroup - 1) / kRowsPerWorkgroup);
  queue.parallel_for<PaddedToExpertKernel>(
      sycl::nd_range<1>(sycl::range<1>(groups * kThreads),
                        sycl::range<1>(kThreads)),
      [=](sycl::nd_item<1> item) {
        const int64_t base_row =
            static_cast<int64_t>(item.get_group(0)) * kRowsPerWorkgroup;
        const int64_t lane = static_cast<int64_t>(item.get_local_id(0));
        for (int64_t row = base_row;
             row < base_row + kRowsPerWorkgroup && row < padded_rows; ++row) {
          if (!is_valid_padded_row(row, counts, cap)) {
            continue;
          }
          const int64_t slot = slots[row];
          for (int64_t column = lane; column < columns;
               column += static_cast<int64_t>(kThreads)) {
            out[slot * columns + column] = input[row * columns + column];
          }
        }
      });
  return output;
}

// Zero only the ragged tail of each expert-major matrix.  The caller obtains
// ``max_tail`` from the same exact count exchange that selected ``max_rows``;
// this avoids clearing the full [experts, max_rows, columns] allocation when
// balancing leaves only a small dynamic tail.
void zero_expert_row_tails_bf16(const at::Tensor& values,
                                const at::Tensor& group_rows,
                                int64_t max_tail) {
  check_xpu_contiguous(values, "values");
  TORCH_CHECK(values.scalar_type() == at::kBFloat16,
              "values must have dtype torch.bfloat16");
  TORCH_CHECK(values.dim() >= 2,
              "values must have shape [experts, max_rows, ...]");
  check_i32_vector(group_rows, "group_rows");
  TORCH_CHECK(values.device() == group_rows.device(),
              "values and group_rows must share an XPU device");
  const int64_t num_experts = values.size(0);
  const int64_t max_rows = values.size(1);
  TORCH_CHECK(group_rows.numel() == num_experts,
              "group_rows must provide one count per expert");
  TORCH_CHECK(max_tail >= 0 && max_tail <= max_rows,
              "max_tail must be in [0, max_rows]");
  if (num_experts == 0 || max_rows == 0 || max_tail == 0 ||
      values.numel() == 0) {
    return;
  }
  const int64_t columns = values.numel() / (num_experts * max_rows);
  const size_t elements_per_expert = static_cast<size_t>(max_tail * columns);
  const size_t rounded_elements =
      ((elements_per_expert + kThreads - 1) / kThreads) * kThreads;
  const size_t total_items = static_cast<size_t>(num_experts) * rounded_elements;
  const auto* rows = group_rows.data_ptr<int32_t>();
  auto* out = reinterpret_cast<bf16*>(values.data_ptr());
  auto& queue = current_queue(values);
  queue.parallel_for<ZeroExpertRowTailsKernel>(
      sycl::range<1>(total_items), [=](sycl::id<1> index) {
        const size_t linear = index[0];
        const int64_t expert = static_cast<int64_t>(linear / rounded_elements);
        const int64_t offset = static_cast<int64_t>(linear % rounded_elements);
        const int64_t tail_rows = max_rows - static_cast<int64_t>(rows[expert]);
        const int64_t tail_elements = tail_rows * columns;
        if (offset < tail_elements) {
          const int64_t base =
              (expert * max_rows + static_cast<int64_t>(rows[expert])) * columns;
          out[base + offset] = bf16(0.0f);
        }
      });
}

// Restore expert-major vector rows to the original source-major padded EP
// layout.  Invalid transport rows are explicitly zero-filled for all-to-all.
at::Tensor expert_rows_to_padded_bf16(const at::Tensor& expert_values,
                                      const at::Tensor& source_slots,
                                      const at::Tensor& recv_counts,
                                      int64_t cap,
                                      bool fuse_padding_zero) {
  check_xpu_contiguous(expert_values, "expert_values");
  TORCH_CHECK(expert_values.scalar_type() == at::kBFloat16,
              "expert_values must have dtype torch.bfloat16");
  TORCH_CHECK(expert_values.dim() == 3,
              "expert_values must have shape [experts, max_rows, columns]");
  check_i64_vector(source_slots, "source_slots");
  check_counts(recv_counts);
  TORCH_CHECK(expert_values.device() == source_slots.device() &&
                  expert_values.device() == recv_counts.device(),
              "expert_values, source_slots, and recv_counts must share an XPU device");
  TORCH_CHECK(cap >= 0, "cap must be nonnegative");
  const int64_t padded_rows = recv_counts.numel() * cap;
  TORCH_CHECK(source_slots.numel() == padded_rows,
              "source_slots must provide one slot per padded row");
  const int64_t columns = expert_values.size(2);
  const int64_t expert_rows = expert_values.size(0) * expert_values.size(1);
  auto output = fuse_padding_zero
      ? (expert_rows == 0 && padded_rows != 0
             ? at::zeros({padded_rows, columns}, expert_values.options())
             : at::empty({padded_rows, columns}, expert_values.options()))
      : at::zeros({padded_rows, columns}, expert_values.options());
  if (padded_rows == 0 || columns == 0 || expert_rows == 0) {
    return output;
  }
  const auto* input = reinterpret_cast<const bf16*>(expert_values.data_ptr());
  const auto* slots = source_slots.data_ptr<int64_t>();
  const auto* counts = recv_counts.data_ptr<int64_t>();
  auto* out = reinterpret_cast<bf16*>(output.data_ptr());
  auto& queue = current_queue(expert_values);
  const size_t groups = static_cast<size_t>(
      (padded_rows + kRowsPerWorkgroup - 1) / kRowsPerWorkgroup);
  queue.parallel_for<ExpertToPaddedKernel>(
      sycl::nd_range<1>(sycl::range<1>(groups * kThreads),
                        sycl::range<1>(kThreads)),
      [=](sycl::nd_item<1> item) {
        const int64_t base_row =
            static_cast<int64_t>(item.get_group(0)) * kRowsPerWorkgroup;
        const int64_t lane = static_cast<int64_t>(item.get_local_id(0));
        for (int64_t row = base_row;
             row < base_row + kRowsPerWorkgroup && row < padded_rows; ++row) {
          const bool valid = is_valid_padded_row(row, counts, cap);
          if (!valid && !fuse_padding_zero) {
            continue;
          }
          const int64_t slot = valid ? slots[row] : 0;
          for (int64_t column = lane; column < columns;
               column += static_cast<int64_t>(kThreads)) {
            if (valid) {
              out[row * columns + column] = input[slot * columns + column];
            } else {
              out[row * columns + column] = bf16(0.0f);
            }
          }
        }
      });
  return output;
}

// Restore and multiply one score per expert row in a single pass.  EP-local
// expert routes have exactly one choice, so this is mathematically identical
// to the generic top-k=1 weighted route reduction followed by expansion.
at::Tensor weighted_expert_rows_to_padded_bf16(
    const at::Tensor& expert_values, const at::Tensor& expert_scores,
    const at::Tensor& source_slots, const at::Tensor& recv_counts,
    int64_t cap, bool fuse_padding_zero) {
  check_xpu_contiguous(expert_values, "expert_values");
  check_xpu_contiguous(expert_scores, "expert_scores");
  TORCH_CHECK(expert_values.scalar_type() == at::kBFloat16 &&
                  expert_scores.scalar_type() == at::kBFloat16,
              "expert_values and expert_scores must have dtype torch.bfloat16");
  TORCH_CHECK(expert_values.dim() == 3,
              "expert_values must have shape [experts, max_rows, columns]");
  TORCH_CHECK(expert_scores.dim() == 2 &&
                  expert_scores.size(0) == expert_values.size(0) &&
                  expert_scores.size(1) == expert_values.size(1),
              "expert_scores must have shape [experts, max_rows]");
  check_i64_vector(source_slots, "source_slots");
  check_counts(recv_counts);
  TORCH_CHECK(expert_values.device() == expert_scores.device() &&
                  expert_values.device() == source_slots.device() &&
                  expert_values.device() == recv_counts.device(),
              "expert layout inputs must share an XPU device");
  TORCH_CHECK(cap >= 0, "cap must be nonnegative");
  const int64_t padded_rows = recv_counts.numel() * cap;
  TORCH_CHECK(source_slots.numel() == padded_rows,
              "source_slots must provide one slot per padded row");
  const int64_t columns = expert_values.size(2);
  const int64_t expert_rows = expert_values.size(0) * expert_values.size(1);
  auto output = fuse_padding_zero
      ? (expert_rows == 0 && padded_rows != 0
             ? at::zeros({padded_rows, columns}, expert_values.options())
             : at::empty({padded_rows, columns}, expert_values.options()))
      : at::zeros({padded_rows, columns}, expert_values.options());
  if (padded_rows == 0 || columns == 0 || expert_rows == 0) {
    return output;
  }
  const auto* input = reinterpret_cast<const bf16*>(expert_values.data_ptr());
  const auto* scores = reinterpret_cast<const bf16*>(expert_scores.data_ptr());
  const auto* slots = source_slots.data_ptr<int64_t>();
  const auto* counts = recv_counts.data_ptr<int64_t>();
  auto* out = reinterpret_cast<bf16*>(output.data_ptr());
  auto& queue = current_queue(expert_values);
  const size_t groups = static_cast<size_t>(
      (padded_rows + kRowsPerWorkgroup - 1) / kRowsPerWorkgroup);
  queue.parallel_for<WeightedExpertToPaddedKernel>(
      sycl::nd_range<1>(sycl::range<1>(groups * kThreads),
                        sycl::range<1>(kThreads)),
      [=](sycl::nd_item<1> item) {
        const int64_t base_row =
            static_cast<int64_t>(item.get_group(0)) * kRowsPerWorkgroup;
        const int64_t lane = static_cast<int64_t>(item.get_local_id(0));
        for (int64_t row = base_row;
             row < base_row + kRowsPerWorkgroup && row < padded_rows; ++row) {
          const bool valid = is_valid_padded_row(row, counts, cap);
          if (!valid && !fuse_padding_zero) {
            continue;
          }
          const int64_t slot = valid ? slots[row] : 0;
          const float score = valid ? static_cast<float>(scores[slot]) : 0.0f;
          for (int64_t column = lane; column < columns;
               column += static_cast<int64_t>(kThreads)) {
            if (valid) {
              out[row * columns + column] = bf16(
                  static_cast<float>(input[slot * columns + column]) * score);
            } else {
              out[row * columns + column] = bf16(0.0f);
            }
          }
        }
      });
  return output;
}

// Restore an expert-major token gradient and its scalar router-score gradient
// directly into the original fused transport-payload layout.  This avoids
// materializing ``cat([tokens, score])`` and, for the BF16-ID fast path, a
// second cat solely to append an identically-zero ID gradient.
at::Tensor expert_token_score_to_padded_bf16(
    const at::Tensor& expert_tokens, const at::Tensor& expert_scores,
    const at::Tensor& source_slots, const at::Tensor& recv_counts,
    int64_t cap, int64_t payload_columns, bool fuse_padding_zero) {
  check_xpu_contiguous(expert_tokens, "expert_tokens");
  check_xpu_contiguous(expert_scores, "expert_scores");
  TORCH_CHECK(expert_tokens.scalar_type() == at::kBFloat16 &&
                  expert_scores.scalar_type() == at::kBFloat16,
              "expert_tokens and expert_scores must have dtype torch.bfloat16");
  TORCH_CHECK(expert_tokens.dim() == 3,
              "expert_tokens must have shape [experts, max_rows, model_dim]");
  TORCH_CHECK(expert_scores.dim() == 2 &&
                  expert_scores.size(0) == expert_tokens.size(0) &&
                  expert_scores.size(1) == expert_tokens.size(1),
              "expert_scores must have shape [experts, max_rows]");
  check_i64_vector(source_slots, "source_slots");
  check_counts(recv_counts);
  TORCH_CHECK(expert_tokens.device() == expert_scores.device() &&
                  expert_tokens.device() == source_slots.device() &&
                  expert_tokens.device() == recv_counts.device(),
              "expert token/score layout inputs must share an XPU device");
  TORCH_CHECK(cap >= 0, "cap must be nonnegative");
  const int64_t padded_rows = recv_counts.numel() * cap;
  TORCH_CHECK(source_slots.numel() == padded_rows,
              "source_slots must provide one slot per padded row");
  const int64_t token_columns = expert_tokens.size(2);
  TORCH_CHECK(payload_columns == token_columns + 1 ||
                  payload_columns == token_columns + 2,
              "payload_columns must hold token, score, and optional ID columns");
  const int64_t expert_rows = expert_tokens.size(0) * expert_tokens.size(1);
  auto output = fuse_padding_zero
      ? (expert_rows == 0 && padded_rows != 0
             ? at::zeros({padded_rows, payload_columns}, expert_tokens.options())
             : at::empty({padded_rows, payload_columns}, expert_tokens.options()))
      : at::zeros({padded_rows, payload_columns}, expert_tokens.options());
  if (padded_rows == 0 || token_columns == 0 || expert_rows == 0) {
    return output;
  }
  const auto* tokens = reinterpret_cast<const bf16*>(expert_tokens.data_ptr());
  const auto* scores = reinterpret_cast<const bf16*>(expert_scores.data_ptr());
  const auto* slots = source_slots.data_ptr<int64_t>();
  const auto* counts = recv_counts.data_ptr<int64_t>();
  auto* out = reinterpret_cast<bf16*>(output.data_ptr());
  auto& queue = current_queue(expert_tokens);
  const size_t groups = static_cast<size_t>(
      (padded_rows + kRowsPerWorkgroup - 1) / kRowsPerWorkgroup);
  queue.parallel_for<ExpertTokenScoreToPaddedKernel>(
      sycl::nd_range<1>(sycl::range<1>(groups * kThreads),
                        sycl::range<1>(kThreads)),
      [=](sycl::nd_item<1> item) {
        const int64_t base_row =
            static_cast<int64_t>(item.get_group(0)) * kRowsPerWorkgroup;
        const int64_t lane = static_cast<int64_t>(item.get_local_id(0));
        for (int64_t row = base_row;
             row < base_row + kRowsPerWorkgroup && row < padded_rows; ++row) {
          const bool valid = is_valid_padded_row(row, counts, cap);
          if (!valid && !fuse_padding_zero) {
            continue;
          }
          const int64_t slot = valid ? slots[row] : 0;
          for (int64_t column = lane; column < payload_columns;
               column += static_cast<int64_t>(kThreads)) {
            if (valid && column < token_columns) {
              out[row * payload_columns + column] =
                  tokens[slot * token_columns + column];
            } else if (valid && column == token_columns) {
              out[row * payload_columns + column] = scores[slot];
            } else {
              out[row * payload_columns + column] = bf16(0.0f);
            }
          }
        }
      });
  return output;
}

}  // namespace aurora_moe

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module) {
  module.def("count_padded_expert_ids_i64",
             &aurora_moe::count_padded_expert_ids_i64,
             "Count valid padded routes by int64 local expert ID (XPU)");
  module.def("count_padded_payload_expert_ids_bf16",
             &aurora_moe::count_padded_payload_expert_ids_bf16,
             "Count valid padded routes by BF16 payload local ID (XPU)");
  module.def("pack_padded_payload_ids_i64_to_expert_bf16",
             &aurora_moe::pack_padded_payload_ids_i64_to_expert_bf16,
             "Pack padded payload and int64 IDs into exact expert rows (XPU)");
  module.def("pack_padded_payload_ids_bf16_to_expert_bf16",
             &aurora_moe::pack_padded_payload_ids_bf16_to_expert_bf16,
             "Pack padded BF16-ID payload into exact expert rows (XPU)");
  module.def("padded_rows_to_expert_bf16",
             &aurora_moe::padded_rows_to_expert_bf16,
             "Map padded source rows to exact expert rows (XPU)");
  module.def("zero_expert_row_tails_bf16",
             &aurora_moe::zero_expert_row_tails_bf16,
             "Zero only ragged expert-major row tails (XPU)");
  module.def("expert_rows_to_padded_bf16",
             &aurora_moe::expert_rows_to_padded_bf16,
             "Map exact expert rows to zero-filled padded source rows (XPU)");
  module.def("weighted_expert_rows_to_padded_bf16",
             &aurora_moe::weighted_expert_rows_to_padded_bf16,
             "Map and score exact expert rows to padded source rows (XPU)");
  module.def("expert_token_score_to_padded_bf16",
             &aurora_moe::expert_token_score_to_padded_bf16,
             "Map expert token/score gradients to fused padded payload rows (XPU)");
}
