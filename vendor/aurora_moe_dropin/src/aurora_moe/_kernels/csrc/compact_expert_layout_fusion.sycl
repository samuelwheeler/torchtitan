//
// Exact compact expert-row layout and route-transform fusion for Aurora XPU.

#include <ATen/ATen.h>
#include <c10/xpu/XPUStream.h>
#include <pybind11/stl.h>
#include <sycl/sycl.hpp>
#include <torch/extension.h>

#include <cstdint>
#include <limits>
#include <vector>

namespace aurora_moe {
namespace {

using bf16 = sycl::ext::oneapi::bfloat16;

constexpr size_t kThreads = 256;
constexpr int64_t kRowsPerWorkgroup = 4;

using AtomicCounter = sycl::atomic_ref<
    int32_t, sycl::memory_order::relaxed, sycl::memory_scope::device,
    sycl::access::address_space::global_space>;

class CompactCountKernel;
class CompactOffsetsKernel;
class CompactPackKernel;
class CompactWeightedScatterKernel;
class CompactRouteGradKernel;
class CompactTokenScoreScatterKernel;

void check_xpu_contiguous(const at::Tensor& tensor, const char* name) {
  TORCH_CHECK(tensor.device().type() == c10::DeviceType::XPU, name,
              " must be an XPU tensor");
  TORCH_CHECK(tensor.is_contiguous(), name, " must be contiguous");
}

void check_bf16_matrix(const at::Tensor& tensor, const char* name) {
  check_xpu_contiguous(tensor, name);
  TORCH_CHECK(tensor.scalar_type() == at::kBFloat16, name,
              " must have dtype torch.bfloat16");
  TORCH_CHECK(tensor.dim() == 2, name, " must be rank 2");
}

void check_i64_vector(const at::Tensor& tensor, const char* name) {
  check_xpu_contiguous(tensor, name);
  TORCH_CHECK(tensor.scalar_type() == at::kLong, name,
              " must have dtype torch.int64");
  TORCH_CHECK(tensor.dim() == 1, name, " must be rank 1");
}

sycl::queue& current_queue(const at::Tensor& tensor) {
  return c10::xpu::getCurrentXPUStream(tensor.get_device()).queue();
}

inline bool is_valid_padded_row(int64_t row, const int64_t* counts,
                                int64_t cap) {
  return cap > 0 && row % cap < counts[row / cap];
}

void check_padded_contract(const at::Tensor& recv_counts, int64_t cap,
                           int64_t padded_rows) {
  check_i64_vector(recv_counts, "recv_counts");
  TORCH_CHECK(cap >= 0, "cap must be nonnegative");
  TORCH_CHECK(recv_counts.numel() * cap == padded_rows,
              "padded rows must equal recv_counts.numel() * cap");
  TORCH_CHECK(padded_rows <= std::numeric_limits<int32_t>::max(),
              "compact layout currently requires at most int32-max padded rows");
}

void check_compact_rows(const at::Tensor& values, const at::Tensor& scores,
                        const at::Tensor& source_to_compact,
                        const at::Tensor& recv_counts, int64_t cap) {
  check_bf16_matrix(values, "expert_values");
  check_xpu_contiguous(scores, "expert_scores");
  TORCH_CHECK(scores.scalar_type() == at::kBFloat16 && scores.dim() == 1,
              "expert_scores must be a BF16 rank-1 tensor");
  check_i64_vector(source_to_compact, "source_to_compact");
  check_padded_contract(recv_counts, cap, source_to_compact.numel());
  TORCH_CHECK(values.size(0) == scores.numel(),
              "expert values and scores must have the same compact row count");
  TORCH_CHECK(values.device() == scores.device() &&
                  values.device() == source_to_compact.device() &&
                  values.device() == recv_counts.device(),
              "compact layout tensors must share an XPU device");
}

}  // namespace

// Count exact valid routes, construct device-resident exclusive expert offsets,
// and pack source-major payload rows into a compact concatenated expert layout.
// ``total_rows`` is the exact sum of recv_counts; the caller may obtain it from
// the existing dispatch count exchange without introducing a capacity factor.
std::vector<at::Tensor> build_compact_layout_bf16(
    const at::Tensor& payload, const at::Tensor& local_ids,
    const at::Tensor& recv_counts, int64_t cap, int64_t num_experts,
    int64_t total_rows, bool embedded_ids) {
  check_bf16_matrix(payload, "payload");
  check_i64_vector(local_ids, "local_ids");
  check_padded_contract(recv_counts, cap, payload.size(0));
  TORCH_CHECK(num_experts > 0, "num_experts must be positive");
  TORCH_CHECK(total_rows >= 0 && total_rows <= payload.size(0),
              "total_rows must be in [0, padded_rows]");
  TORCH_CHECK(payload.device() == recv_counts.device() &&
                  payload.device() == local_ids.device(),
              "payload, IDs, and recv_counts must share an XPU device");
  if (embedded_ids) {
    TORCH_CHECK(num_experts <= 256,
                "embedded BF16 IDs require at most 256 local experts");
    TORCH_CHECK(payload.size(1) >= 3,
                "embedded-ID payload needs token, score, and ID columns");
    TORCH_CHECK(local_ids.numel() == 0,
                "embedded-ID layout requires an empty local_ids tensor");
  } else {
    TORCH_CHECK(payload.size(1) >= 2,
                "payload needs token columns and one score column");
    TORCH_CHECK(local_ids.numel() == payload.size(0),
                "local_ids must provide one ID per padded source row");
  }

  const int64_t padded_rows = payload.size(0);
  const int64_t token_columns = payload.size(1) - (embedded_ids ? 2 : 1);
  auto tokens = at::empty({total_rows, token_columns}, payload.options());
  auto scores = at::empty({total_rows}, payload.options());
  auto source_to_compact = at::empty(
      {padded_rows}, payload.options().dtype(at::kLong));
  auto compact_to_source = at::empty(
      {total_rows}, payload.options().dtype(at::kLong));
  auto group_rows = at::zeros(
      {num_experts}, payload.options().dtype(at::kInt));
  auto expert_offsets = at::empty(
      {num_experts + 1}, payload.options().dtype(at::kLong));
  auto counters = at::zeros(
      {num_experts}, payload.options().dtype(at::kInt));
  if (padded_rows == 0) {
    expert_offsets.zero_();
    return {tokens, scores, source_to_compact, compact_to_source, group_rows,
            expert_offsets};
  }

  const int64_t payload_columns = payload.size(1);
  const auto* input = reinterpret_cast<const bf16*>(payload.data_ptr());
  const auto* ids = local_ids.data_ptr<int64_t>();
  const auto* counts = recv_counts.data_ptr<int64_t>();
  auto* group_rows_ptr = group_rows.data_ptr<int32_t>();
  auto* offsets_ptr = expert_offsets.data_ptr<int64_t>();
  auto* counters_ptr = counters.data_ptr<int32_t>();
  auto* source_to_compact_ptr = source_to_compact.data_ptr<int64_t>();
  auto* compact_to_source_ptr = compact_to_source.data_ptr<int64_t>();
  auto* token_ptr = reinterpret_cast<bf16*>(tokens.data_ptr());
  auto* score_ptr = reinterpret_cast<bf16*>(scores.data_ptr());
  auto& queue = current_queue(payload);

  const auto count_event = queue.parallel_for<CompactCountKernel>(
      sycl::range<1>(static_cast<size_t>(padded_rows)),
      [=](sycl::id<1> index) {
        const int64_t source_row = static_cast<int64_t>(index[0]);
        if (!is_valid_padded_row(source_row, counts, cap)) {
          return;
        }
        const int64_t expert = embedded_ids
            ? static_cast<int64_t>(static_cast<float>(
                  input[source_row * payload_columns + token_columns + 1]))
            : ids[source_row];
        AtomicCounter(group_rows_ptr[expert]).fetch_add(1);
      });

  const auto offsets_event = queue.submit([&](sycl::handler& cgh) {
    cgh.depends_on(count_event);
    cgh.parallel_for<CompactOffsetsKernel>(sycl::range<1>(1),
                                           [=](sycl::id<1>) {
      int64_t offset = 0;
      offsets_ptr[0] = 0;
      for (int64_t expert = 0; expert < num_experts; ++expert) {
        offset += static_cast<int64_t>(group_rows_ptr[expert]);
        offsets_ptr[expert + 1] = offset;
      }
    });
  });

  const size_t groups = static_cast<size_t>(
      (padded_rows + kRowsPerWorkgroup - 1) / kRowsPerWorkgroup);
  queue.submit([&](sycl::handler& cgh) {
    cgh.depends_on(offsets_event);
    sycl::local_accessor<int64_t, 1> compact_slots(
        sycl::range<1>(kRowsPerWorkgroup), cgh);
    cgh.parallel_for<CompactPackKernel>(
        sycl::nd_range<1>(sycl::range<1>(groups * kThreads),
                          sycl::range<1>(kThreads)),
        [=](sycl::nd_item<1> item) {
          const int64_t base_row =
              static_cast<int64_t>(item.get_group(0)) * kRowsPerWorkgroup;
          const int64_t lane = static_cast<int64_t>(item.get_local_id(0));
          if (lane < kRowsPerWorkgroup) {
            const int64_t source_row = base_row + lane;
            int64_t compact_row = -1;
            if (source_row < padded_rows &&
                is_valid_padded_row(source_row, counts, cap)) {
              const int64_t expert = embedded_ids
                  ? static_cast<int64_t>(static_cast<float>(
                        input[source_row * payload_columns + token_columns + 1]))
                  : ids[source_row];
              const int32_t local_row =
                  AtomicCounter(counters_ptr[expert]).fetch_add(1);
              compact_row = offsets_ptr[expert] + static_cast<int64_t>(local_row);
              source_to_compact_ptr[source_row] = compact_row;
              compact_to_source_ptr[compact_row] = source_row;
            }
            compact_slots[lane] = compact_row;
          }
          item.barrier(sycl::access::fence_space::local_space);
          for (int64_t source_row = base_row;
               source_row < base_row + kRowsPerWorkgroup &&
               source_row < padded_rows; ++source_row) {
            const int64_t compact_row = compact_slots[source_row - base_row];
            if (compact_row < 0) {
              continue;
            }
            for (int64_t column = lane; column < token_columns;
                 column += static_cast<int64_t>(kThreads)) {
              token_ptr[compact_row * token_columns + column] =
                  input[source_row * payload_columns + column];
            }
            if (lane == 0) {
              score_ptr[compact_row] =
                  input[source_row * payload_columns + token_columns];
            }
          }
        });
  });
  return {tokens, scores, source_to_compact, compact_to_source, group_rows,
          expert_offsets};
}

// Score and scatter exact compact expert rows.  Invalid transport rows are
// zeroed in this same kernel, avoiding a separate full padded-output fill.
at::Tensor weighted_compact_rows_to_padded_bf16(
    const at::Tensor& expert_values, const at::Tensor& expert_scores,
    const at::Tensor& source_to_compact, const at::Tensor& recv_counts,
    int64_t cap) {
  check_compact_rows(expert_values, expert_scores, source_to_compact,
                     recv_counts, cap);
  const int64_t padded_rows = source_to_compact.numel();
  const int64_t columns = expert_values.size(1);
  auto output = at::empty({padded_rows, columns}, expert_values.options());
  if (padded_rows == 0 || columns == 0) {
    return output;
  }
  const auto* values = reinterpret_cast<const bf16*>(expert_values.data_ptr());
  const auto* scores = reinterpret_cast<const bf16*>(expert_scores.data_ptr());
  const auto* source_slots = source_to_compact.data_ptr<int64_t>();
  const auto* counts = recv_counts.data_ptr<int64_t>();
  auto* out = reinterpret_cast<bf16*>(output.data_ptr());
  const size_t groups = static_cast<size_t>(
      (padded_rows + kRowsPerWorkgroup - 1) / kRowsPerWorkgroup);
  current_queue(expert_values).parallel_for<CompactWeightedScatterKernel>(
      sycl::nd_range<1>(sycl::range<1>(groups * kThreads),
                        sycl::range<1>(kThreads)),
      [=](sycl::nd_item<1> item) {
        const int64_t base_row =
            static_cast<int64_t>(item.get_group(0)) * kRowsPerWorkgroup;
        const int64_t lane = static_cast<int64_t>(item.get_local_id(0));
        for (int64_t source_row = base_row;
             source_row < base_row + kRowsPerWorkgroup &&
             source_row < padded_rows; ++source_row) {
          const bool valid = is_valid_padded_row(source_row, counts, cap);
          const int64_t compact_row = valid ? source_slots[source_row] : 0;
          const float score = valid
              ? static_cast<float>(scores[compact_row])
              : 0.0f;
          for (int64_t column = lane; column < columns;
               column += static_cast<int64_t>(kThreads)) {
            out[source_row * columns + column] = valid
                ? bf16(static_cast<float>(
                           values[compact_row * columns + column]) * score)
                : bf16(0.0f);
          }
        }
      });
  return output;
}

// Build both compact backward inputs from a compact-to-source inverse map.
// It visits only exact routes, so it does not create or clear a ragged expert
// tail before the dY/dW GEMMs.
std::vector<at::Tensor> compact_route_grad_scale_score_bf16(
    const at::Tensor& grad_output, const at::Tensor& expert_values,
    const at::Tensor& expert_scores, const at::Tensor& compact_to_source) {
  check_bf16_matrix(grad_output, "grad_output");
  check_bf16_matrix(expert_values, "expert_values");
  check_xpu_contiguous(expert_scores, "expert_scores");
  TORCH_CHECK(expert_scores.scalar_type() == at::kBFloat16 &&
                  expert_scores.dim() == 1,
              "expert_scores must be a BF16 rank-1 tensor");
  check_i64_vector(compact_to_source, "compact_to_source");
  TORCH_CHECK(grad_output.device() == expert_values.device() &&
                  grad_output.device() == expert_scores.device() &&
                  grad_output.device() == compact_to_source.device(),
              "compact route-gradient tensors must share an XPU device");
  TORCH_CHECK(grad_output.size(1) == expert_values.size(1),
              "grad_output and expert_values must have the same model dimension");
  TORCH_CHECK(expert_values.size(0) == expert_scores.numel() &&
                  expert_values.size(0) == compact_to_source.numel(),
              "compact row counts must agree");
  const int64_t compact_rows = expert_values.size(0);
  const int64_t columns = expert_values.size(1);
  auto grad_values = at::empty_like(expert_values);
  auto grad_scores = at::empty({compact_rows}, expert_values.options());
  if (compact_rows == 0) {
    return {grad_values, grad_scores};
  }
  if (columns == 0) {
    return {grad_values, at::zeros({compact_rows}, expert_values.options())};
  }
  const auto* grad_output_ptr =
      reinterpret_cast<const bf16*>(grad_output.data_ptr());
  const auto* expert_values_ptr =
      reinterpret_cast<const bf16*>(expert_values.data_ptr());
  const auto* expert_scores_ptr =
      reinterpret_cast<const bf16*>(expert_scores.data_ptr());
  const auto* sources = compact_to_source.data_ptr<int64_t>();
  auto* grad_values_ptr = reinterpret_cast<bf16*>(grad_values.data_ptr());
  auto* grad_scores_ptr = reinterpret_cast<bf16*>(grad_scores.data_ptr());
  const size_t groups = static_cast<size_t>(compact_rows);
  current_queue(grad_output).submit([&](sycl::handler& cgh) {
    sycl::local_accessor<float, 1> partial_sums(sycl::range<1>(kThreads), cgh);
    cgh.parallel_for<CompactRouteGradKernel>(
        sycl::nd_range<1>(sycl::range<1>(groups * kThreads),
                          sycl::range<1>(kThreads)),
        [=](sycl::nd_item<1> item) {
          const int64_t compact_row = static_cast<int64_t>(item.get_group(0));
          const int64_t lane = static_cast<int64_t>(item.get_local_id(0));
          const int64_t source_row = sources[compact_row];
          const float score = static_cast<float>(expert_scores_ptr[compact_row]);
          float partial = 0.0f;
          for (int64_t column = lane; column < columns;
               column += static_cast<int64_t>(kThreads)) {
            const float grad = static_cast<float>(
                grad_output_ptr[source_row * columns + column]);
            const float value = static_cast<float>(
                expert_values_ptr[compact_row * columns + column]);
            grad_values_ptr[compact_row * columns + column] = bf16(grad * score);
            partial += grad * value;
          }
          partial_sums[lane] = partial;
          item.barrier(sycl::access::fence_space::local_space);
          for (int64_t width = static_cast<int64_t>(kThreads) / 2; width > 0;
               width /= 2) {
            if (lane < width) {
              partial_sums[lane] += partial_sums[lane + width];
            }
            item.barrier(sycl::access::fence_space::local_space);
          }
          if (lane == 0) {
            grad_scores_ptr[compact_row] = bf16(partial_sums[0]);
          }
        });
  });
  return {grad_values, grad_scores};
}

namespace {

at::Tensor compact_token_score_to_padded_impl(
    const at::Tensor& first_tokens, const at::Tensor& second_tokens,
    const at::Tensor& expert_scores, const at::Tensor& source_to_compact,
    const at::Tensor& recv_counts, int64_t cap, int64_t payload_columns,
    bool add_second) {
  check_compact_rows(first_tokens, expert_scores, source_to_compact,
                     recv_counts, cap);
  if (add_second) {
    check_bf16_matrix(second_tokens, "second_tokens");
    TORCH_CHECK(second_tokens.device() == first_tokens.device() &&
                    second_tokens.sizes() == first_tokens.sizes(),
                "second_tokens must match first_tokens");
  } else {
    TORCH_CHECK(second_tokens.numel() == 0,
                "single-token scatter requires an empty second_tokens tensor");
  }
  const int64_t padded_rows = source_to_compact.numel();
  const int64_t token_columns = first_tokens.size(1);
  TORCH_CHECK(payload_columns == token_columns + 1 ||
                  payload_columns == token_columns + 2,
              "payload_columns must hold tokens, score, and optional ID gradient");
  auto output = at::empty(
      {padded_rows, payload_columns}, first_tokens.options());
  if (padded_rows == 0) {
    return output;
  }
  const auto* first = reinterpret_cast<const bf16*>(first_tokens.data_ptr());
  const auto* second = add_second
      ? reinterpret_cast<const bf16*>(second_tokens.data_ptr())
      : nullptr;
  const auto* scores = reinterpret_cast<const bf16*>(expert_scores.data_ptr());
  const auto* source_slots = source_to_compact.data_ptr<int64_t>();
  const auto* counts = recv_counts.data_ptr<int64_t>();
  auto* out = reinterpret_cast<bf16*>(output.data_ptr());
  const size_t groups = static_cast<size_t>(
      (padded_rows + kRowsPerWorkgroup - 1) / kRowsPerWorkgroup);
  current_queue(first_tokens).parallel_for<CompactTokenScoreScatterKernel>(
      sycl::nd_range<1>(sycl::range<1>(groups * kThreads),
                        sycl::range<1>(kThreads)),
      [=](sycl::nd_item<1> item) {
        const int64_t base_row =
            static_cast<int64_t>(item.get_group(0)) * kRowsPerWorkgroup;
        const int64_t lane = static_cast<int64_t>(item.get_local_id(0));
        for (int64_t source_row = base_row;
             source_row < base_row + kRowsPerWorkgroup &&
             source_row < padded_rows; ++source_row) {
          const bool valid = is_valid_padded_row(source_row, counts, cap);
          const int64_t compact_row = valid ? source_slots[source_row] : 0;
          for (int64_t column = lane; column < payload_columns;
               column += static_cast<int64_t>(kThreads)) {
            if (valid && column < token_columns) {
              const float first_value = static_cast<float>(
                  first[compact_row * token_columns + column]);
              const float second_value = add_second ? static_cast<float>(
                  second[compact_row * token_columns + column]) : 0.0f;
              out[source_row * payload_columns + column] =
                  bf16(first_value + second_value);
            } else if (valid && column == token_columns) {
              out[source_row * payload_columns + column] = scores[compact_row];
            } else {
              out[source_row * payload_columns + column] = bf16(0.0f);
            }
          }
        }
      });
  return output;
}

}  // namespace

at::Tensor compact_token_score_to_padded_bf16(
    const at::Tensor& expert_tokens, const at::Tensor& expert_scores,
    const at::Tensor& source_to_compact, const at::Tensor& recv_counts,
    int64_t cap, int64_t payload_columns) {
  auto empty_second = at::empty({0}, expert_tokens.options());
  return compact_token_score_to_padded_impl(
      expert_tokens, empty_second, expert_scores, source_to_compact,
      recv_counts, cap, payload_columns, false);
}

at::Tensor fused_compact_token_add_score_to_padded_bf16(
    const at::Tensor& up_tokens, const at::Tensor& gate_tokens,
    const at::Tensor& expert_scores, const at::Tensor& source_to_compact,
    const at::Tensor& recv_counts, int64_t cap, int64_t payload_columns) {
  return compact_token_score_to_padded_impl(
      up_tokens, gate_tokens, expert_scores, source_to_compact,
      recv_counts, cap, payload_columns, true);
}

}  // namespace aurora_moe

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module) {
  module.def("build_compact_layout_bf16",
             &aurora_moe::build_compact_layout_bf16,
             "Build exact compact expert layout and inverse maps (XPU)");
  module.def("weighted_compact_rows_to_padded_bf16",
             &aurora_moe::weighted_compact_rows_to_padded_bf16,
             "Score/scatter compact expert rows to padded source rows (XPU)");
  module.def("compact_route_grad_scale_score_bf16",
             &aurora_moe::compact_route_grad_scale_score_bf16,
             "Prepare compact dY and dscore route gradients (XPU)");
  module.def("compact_token_score_to_padded_bf16",
             &aurora_moe::compact_token_score_to_padded_bf16,
             "Scatter compact token/score gradients to padded A4 rows (XPU)");
  module.def("fused_compact_token_add_score_to_padded_bf16",
             &aurora_moe::fused_compact_token_add_score_to_padded_bf16,
             "Fuse compact dX add and padded A4 scatter (XPU)");
}
