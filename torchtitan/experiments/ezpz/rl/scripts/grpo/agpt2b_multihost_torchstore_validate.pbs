#!/bin/bash --login
#PBS -A datascience
#PBS -N mds154391-mh-sync
#PBS -l walltime=00:45:00
#PBS -l filesystems=tegu:home
#PBS -l select=2
#PBS -q workq
#PBS -j oe
set -euo pipefail

WT="${PBS_O_WORKDIR:-$(pwd)}"
V="${V:-/lus/tegu/projects/datascience/foremans/venvs/rl-monarch-torch214}"
CKPT="${CKPT:-/lus/tegu/projects/datascience/foremans/reproductions/agpt2b-mds154391-broad-grain-sft900/stage2/agpt2b-mds154391-step600-gsm8k-r1cot-2n-r2/final}"
OUT="${OUT:-/lus/tegu/projects/datascience/foremans/reproductions/agpt2b-mds154391-broad-grain-sft900/grpo/agpt2b-multihost-sync-${PBS_JOBID%%.*}}"
: "${EXPECTED_COMMIT:?submit with -v EXPECTED_COMMIT=<exact-pushed-sha>}"

source <(curl -fsSL https://bit.ly/ezpz-utils) || exit 12
ezpz_setup "$V" || exit 13
[[ "$ZE_FLAT_DEVICE_HIERARCHY" == FLAT ]] || exit 14
cd "$WT" || exit 11
actual_commit=$(git rev-parse HEAD) || exit 15
[[ "$actual_commit" == "$EXPECTED_COMMIT" ]] || {
  echo "FATAL: commit mismatch expected=$EXPECTED_COMMIT actual=$actual_commit"
  exit 15
}
git diff --quiet && git diff --cached --quiet || {
  echo "FATAL: tracked worktree changes present"
  exit 15
}

export PATH="$V/bin:/opt/pbs/bin:$PATH"
export PYTHONPATH="$WT${PYTHONPATH:+:$PYTHONPATH}"
export TORCHINDUCTOR_MAX_AUTOTUNE=0
export VLLM_ENABLE_V1_MULTIPROCESSING=1
export WANDB_MODE=disabled HF_DATASETS_OFFLINE=1 HF_HUB_OFFLINE=1
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export ZE_FLAT_DEVICE_HIERARCHY=FLAT
export TORCHSTORE_TRANSPORT="${TORCHSTORE_TRANSPORT:-auto}"
case "${TORCHSTORE_TRANSPORT}" in
  auto)
    unset TORCHTITAN_TORCHSTORE_TRANSPORT TORCHSTORE_SHARED_MEMORY_ENABLED
    ;;
  auto_no_shm)
    unset TORCHTITAN_TORCHSTORE_TRANSPORT
    export TORCHSTORE_SHARED_MEMORY_ENABLED=0
    ;;
  gloo|xccl|monarch_rdma)
    export TORCHTITAN_TORCHSTORE_TRANSPORT="${TORCHSTORE_TRANSPORT}"
    ;;
  *) echo "FATAL: unsupported TORCHSTORE_TRANSPORT=${TORCHSTORE_TRANSPORT}"; exit 15 ;;
esac
unset TORCHSTORE_GLOO_ENABLED TORCHSTORE_XCCL_ENABLED
unset CCL_OP_SYNC CCL_OFI_PROVIDER
export CCL_PROCESS_LAUNCHER=none CCL_ATL_TRANSPORT=ofi FI_PROVIDER=tcp
head_node=$(head -1 "$PBS_NODEFILE")
export CCL_KVS_IP_PORT="${head_node}_$((29500 + ${PBS_JOBID%%.*} % 1000))"

[[ -s "$CKPT/model.safetensors" ]] || { echo "FATAL: model missing"; exit 16; }
[[ -s "$CKPT/chat_template.jinja" ]] || { echo "FATAL: chat template missing"; exit 16; }
[[ ! -e "$OUT" ]] || { echo "FATAL: output exists: $OUT"; exit 17; }
mkdir -p "$OUT"
STORE="$WT/.multihost-rl-${PBS_JOBID%%.*}.store"
rm -f "$STORE"
PORT=$((35000 + ${PBS_JOBID%%.*} % 20000))

"$V/bin/python" -m py_compile \
  torchtitan/experiments/ezpz/rl/scripts/grpo/multihost_train_upstream.py
"$V/bin/python" - <<'PY'
import os
from torchtitan.experiments.ezpz.rl.reason_agpt.config_registry import (
    rl_grpo_lora_agpt_2b_gsm8k_b2smoke,
)
c = rl_grpo_lora_agpt_2b_gsm8k_b2smoke()
assert c.async_loop.num_samples_per_prompt == 4
assert c.generator.model_dtype == "float32"
assert tuple(c.renderer.extra_stop_token_ids) == (1, 107)
requested = os.environ.get("TORCHTITAN_TORCHSTORE_TRANSPORT", "auto")
assert requested in {"auto", "gloo", "xccl", "monarch_rdma"}
if os.environ.get("TORCHSTORE_TRANSPORT") == "auto_no_shm":
    assert os.environ["TORCHSTORE_SHARED_MEMORY_ENABLED"] == "0"
print(
    f"MULTIHOST_RL_PREFLIGHT_OK transport={requested} "
    f"shared_memory={os.environ.get('TORCHSTORE_SHARED_MEMORY_ENABLED', 'default')}"
)
PY

echo "MULTIHOST_RL_START commit=$actual_commit transport=$TORCHSTORE_TRANSPORT trainer_host=0 generator_host=1 out=$OUT $(date -Is)"
set +e
"$V/bin/ezpz" launch -n 2 -ppn 1 --cpu-bind none --timeout 1800 -- \
  "$V/bin/python" -u \
  torchtitan/experiments/ezpz/rl/scripts/grpo/multihost_train_upstream.py \
  --multihost-store "$STORE" --multihost-port "$PORT" --multihost-world-size 2 \
  --module torchtitan.experiments.ezpz.rl.reason_agpt \
  --config rl_grpo_lora_agpt_2b_gsm8k_b2smoke \
  --hf_assets_path="$CKPT" \
  --dump_folder="$OUT" \
  --async-loop.num-training-steps=3 \
  --async-loop.num-prompts-per-train-step=4 \
  --async-loop.num-samples-per-prompt=4 \
  --async-loop.target-offpolicy-steps=0 \
  --async-loop.validation.num-samples=8 \
  --async-loop.training-sample-builder.no-drop-zero-std-reward-groups \
  --generator.sampling.max-tokens=700 \
  --generator.parallelism.data-parallel-degree=1 \
  --generator.parallelism.tensor-parallel-degree=1 \
  --trainer.parallelism.data-parallel-shard-degree=1 \
  --trainer.parallelism.tensor-parallel-degree=1 \
  --trainer.checkpointer.interval=1 \
  --metrics.no-enable-wandb
rc=$?
set -e
rm -f "$STORE"
echo "MULTIHOST_RL_DONE rc=$rc $(date -Is)"
[[ "$rc" -eq 0 ]] || exit "$rc"
