#!/bin/bash -l
#PBS -A AuroraGPT
#PBS -q debug-scaling
#PBS -l select=2
#PBS -l walltime=00:30:00
#PBS -l filesystems=flare:home
#PBS -N tt-dsv3-moe-2n-thapi
#PBS -j oe
#PBS -o /dev/null

set -euo pipefail

LAUNCHER_REL_PATH="torchtitan/experiments/ezpz/moe_runs/launch_deepseek_v3_moe_ep12.sh"
CONFIG_REL_PATH="torchtitan/experiments/ezpz/moe_runs/aurora_2nodes_ep12/deepseek_v3_10b2b_ep12_2nodes_4096_prod_sim_ac_lb2_flex_compile_model.json"
SUBMITTER_REL_PATH="torchtitan/experiments/ezpz/moe_runs/aurora_2nodes_ep12/submit_deepseek_v3_moe_ep12_2n_thapi_profile.pbs"

resolve_repo_root() {
  local candidate="$1"

  while [[ -n "${candidate}" && "${candidate}" != "/" ]]; do
    if [[ -f "${candidate}/${LAUNCHER_REL_PATH}" ]]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
    candidate="$(dirname "${candidate}")"
  done

  return 1
}

REPO_ROOT="$(resolve_repo_root "${REPO_ROOT:-${PBS_O_WORKDIR:-$(pwd)}}")" || {
  echo "Unable to locate repo root containing ${LAUNCHER_REL_PATH}." >&2
  echo "Pass REPO_ROOT=/path/to/torchtitan if you submit from outside the repo." >&2
  exit 1
}

if [[ -n "${PBS_O_WORKDIR:-}" ]]; then
  cd "${PBS_O_WORKDIR}"
fi

module load thapi/git.426c809

RUN_NAME="${RUN_NAME:-deepseek_v3_10b2b_ep12_2n_thapi_${PBS_JOBID%%.*}}"
RUN_SLUG="$(echo "${RUN_NAME}" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9._-' '-')"
export RUN_ROOT_OVERRIDE="${RUN_ROOT_OVERRIDE:-${REPO_ROOT}/outputs/moe_runs/${RUN_SLUG}}"
export RUN_SUBMITTER_PATH="${REPO_ROOT}/${SUBMITTER_REL_PATH}"

mkdir -p "${RUN_ROOT_OVERRIDE}/logs"
exec > >(tee -a "${RUN_ROOT_OVERRIDE}/logs/batch.log") 2>&1

cd "${REPO_ROOT}"

TRAINING_STEPS="${TRAINING_STEPS:-10}"
OPTIMIZER="${OPTIMIZER:-muon}"
OPTIMIZER_LR="${OPTIMIZER_LR:-0.01}"

export TT_CONFIG_JSON="${TT_CONFIG_JSON:-${REPO_ROOT}/${CONFIG_REL_PATH}}"
export HF_ASSETS_PATH="${HF_ASSETS_PATH:-${REPO_ROOT}/assets/hf/gemma-7b}"

export WANDB_PROJECT="${WANDB_PROJECT:-torchtitan.moe_runs}"
export WANDB_TEAM="${WANDB_TEAM:-moe_experiments}"
export WANDB_RUN_GROUP="${WANDB_RUN_GROUP:-deepseek_v3_moe_ep12_2n_thapi}"

export THAPI_ENABLE=1
export THAPI_REPLAY_SUMMARY="${THAPI_REPLAY_SUMMARY:-1}"

echo "Job: ${PBS_JOBID:-no_pbs_jobid}"
echo "Run name: ${RUN_NAME}"
echo "Run root: ${RUN_ROOT_OVERRIDE}"
echo "Batch log: ${RUN_ROOT_OVERRIDE}/logs/batch.log"
echo "TT_CONFIG_JSON: ${TT_CONFIG_JSON}"
echo "HF_ASSETS_PATH: ${HF_ASSETS_PATH}"
echo "Training steps: ${TRAINING_STEPS}"
echo "Optimizer: ${OPTIMIZER}"
echo "Optimizer lr: ${OPTIMIZER_LR}"
echo "iprof: $(command -v iprof)"

module list 2>&1 | sed -n '1,120p'

bash "${REPO_ROOT}/${LAUNCHER_REL_PATH}" \
  "${RUN_NAME}" \
  --checkpoint.no_enable \
  --training.steps "${TRAINING_STEPS}" \
  --metrics.log_freq 1 \
  --optimizer "${OPTIMIZER}" \
  --optimizer.lr "${OPTIMIZER_LR}"
